{
  "name": "buildcare-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Buildcare AI API — Express + mysql2 (원격 MariaDB, 컨테이너 없음)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verify-ddl-copy.mjs && vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed:dev": "tsx src/db/seeds/index.ts",
    "job:p0": "tsx src/jobs/cli.ts p0",
    "job:no-response": "tsx src/jobs/cli.ts no-response",
    "job:bms-sync": "tsx src/jobs/cli.ts bms-sync",
    "cleanup:test": "NODE_ENV=test tsx scripts/cleanup-test-data.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\""
  },
  "dependencies": {
    "@google/genai": "^2.26.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "exifr": "^7.1.3",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.4",
    "mysql2": "^3.24.5",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.13",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "express-openapi-validator": "^5.6.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.9",
    "yaml": "^2.9.1"
  }
}
