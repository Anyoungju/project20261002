# backend/.env 로 복사해 값을 채운다. .env 는 커밋 금지. DB 접속 정보는 관리자에게 받는다.
NODE_ENV=development
PORT=9503
APP_ORIGIN=https://p3.sumzip.com
PUBLIC_BASE_URL=https://p3.sumzip.com
JWT_SECRET=
FILE_URL_SECRET=
COOKIE_SECURE=1

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_NAME_TEST=
ALLOW_TEST_ON_DEV_DB=1

AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
BMS_PROVIDER=mock
MAIL_TRANSPORT=console
STORAGE_DIR=./storage

SEED_DEMO_PASSWORD=
SEED_ALLOW_RESET=1
AUTH_LOCK_MAX_FAILS=5
AUTH_LOCK_MINUTES=15
